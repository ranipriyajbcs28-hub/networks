#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
//Complete the following function.


void calculate_the_maximum(int n, int k) {
    int max_and = 0;
    int max_or = 0;
    int max_xor = 0;

    // Check all unique pairs (a, b) such that 1 <= a < b <= n
    for (int a = 1; a < n; a++) {
        for (int b = a + 1; b <= n; b++) {
            int current_and = a & b;
            int current_or  = a | b;
            int current_xor = a ^ b;

            // Keep track of the highest value that is strictly less than k
            if (current_and > max_and && current_and < k) {
                max_and = current_and;
            }
            if (current_or > max_or && current_or < k) {
                max_or = current_or;
            }
            if (current_xor > max_xor && current_xor < k) {
                max_xor = current_xor;
            }
        }
    }

    // Print results on separate lines
    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;
  
    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);
 
    return 0;
}
